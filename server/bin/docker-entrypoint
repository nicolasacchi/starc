#!/bin/bash -e

# Prepare the database before starting the server, whatever is in front of the
# rails binary (e.g. `./bin/thrust ./bin/rails server` or a bare
# `./bin/rails server`). Every other command — one-off `runner`, `console`,
# `db:seed`, ... — is left alone so it doesn't pick up an unexpected migrate.
if [ "${@: -1:1}" = "server" ]; then
  ./bin/rails db:prepare
fi

exec "${@}"
